{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "antaniBg": "#252830",
    "antaniBgRaised": "#2d3038",
    "antaniElement": "#363a42",
    "antaniDivider": "#454b55",
    "antaniTertiary": "#1e2025",
    "antaniText": "#d6d3ca",
    "antaniTextDim": "#a7a8ae",
    "antaniSidebarText": "#c9c6bd",
    "orange": "#d4622a",
    "orangeSoft": "#e0975a",
    "amber": "#fbbf24",
    "red": "#f87171",
    "redDeep": "#c94040",
    "green": "#4ade80",
    "greenSoft": "#8cbf6a",
    "teal": "#2dd4bf",
    "sky": "#0ea5e9",
    "blue": "#5b9bf0",
    "purple": "#a855f7",
    "lightBg": "#f4f1ea",
    "lightBgRaised": "#e9e5db",
    "lightElement": "#ddd8cc",
    "lightDivider": "#c9c3b5",
    "lightText": "#3a3d45",
    "lightTextDim": "#6b6f78",
    "orangeDeep": "#c25422",
    "amberDeep": "#b8801a",
    "redLight": "#c94040",
    "greenLight": "#3a9d5d",
    "skyLight": "#0a7ab5",
    "blueLight": "#2f6fd0",
    "purpleLight": "#8a3fd0",
    "tealLight": "#0d9488"
  },
  "theme": {
    "primary": { "dark": "orange", "light": "orangeDeep" },
    "secondary": { "dark": "amber", "light": "amberDeep" },
    "accent": { "dark": "orangeSoft", "light": "orange" },
    "error": { "dark": "red", "light": "redLight" },
    "warning": { "dark": "amber", "light": "amberDeep" },
    "success": { "dark": "green", "light": "greenLight" },
    "info": { "dark": "sky", "light": "skyLight" },
    "text": { "dark": "antaniText", "light": "lightText" },
    "textMuted": { "dark": "antaniTextDim", "light": "lightTextDim" },
    "background": { "dark": "antaniBg", "light": "lightBg" },
    "backgroundPanel": { "dark": "antaniBgRaised", "light": "lightBgRaised" },
    "backgroundElement": { "dark": "antaniElement", "light": "lightElement" },
    "border": { "dark": "antaniElement", "light": "lightDivider" },
    "borderActive": { "dark": "orange", "light": "orangeDeep" },
    "borderSubtle": { "dark": "antaniBgRaised", "light": "lightBgRaised" },
    "diffAdded": { "dark": "green", "light": "greenLight" },
    "diffRemoved": { "dark": "red", "light": "redLight" },
    "diffContext": { "dark": "antaniTextDim", "light": "lightTextDim" },
    "diffHunkHeader": { "dark": "antaniTextDim", "light": "lightTextDim" },
    "diffHighlightAdded": { "dark": "green", "light": "greenLight" },
    "diffHighlightRemoved": { "dark": "red", "light": "redLight" },
    "diffAddedBg": { "dark": "#2b3a2f", "light": "#dceadd" },
    "diffRemovedBg": { "dark": "#3a2b2d", "light": "#f2dede" },
    "diffContextBg": { "dark": "antaniBgRaised", "light": "lightBgRaised" },
    "diffLineNumber": { "dark": "antaniDivider", "light": "lightDivider" },
    "diffAddedLineNumberBg": { "dark": "#2b3a2f", "light": "#cfe4d1" },
    "diffRemovedLineNumberBg": { "dark": "#3a2b2d", "light": "#ecd4d4" },
    "markdownText": { "dark": "antaniText", "light": "lightText" },
    "markdownHeading": { "dark": "orange", "light": "orangeDeep" },
    "markdownLink": { "dark": "sky", "light": "skyLight" },
    "markdownLinkText": { "dark": "blue", "light": "blueLight" },
    "markdownCode": { "dark": "greenSoft", "light": "greenLight" },
    "markdownBlockQuote": { "dark": "antaniTextDim", "light": "lightTextDim" },
    "markdownEmph": { "dark": "amber", "light": "amberDeep" },
    "markdownStrong": { "dark": "orange", "light": "orangeDeep" },
    "markdownHorizontalRule": { "dark": "antaniDivider", "light": "lightDivider" },
    "markdownListItem": { "dark": "orange", "light": "orangeDeep" },
    "markdownListEnumeration": { "dark": "amber", "light": "amberDeep" },
    "markdownImage": { "dark": "purple", "light": "purpleLight" },
    "markdownImageText": { "dark": "#c495e8", "light": "purpleLight" },
    "markdownCodeBlock": { "dark": "antaniText", "light": "lightText" },
    "syntaxComment": { "dark": "#8b8e95", "light": "#8b8578" },
    "syntaxKeyword": { "dark": "orange", "light": "orangeDeep" },
    "syntaxFunction": { "dark": "blue", "light": "blueLight" },
    "syntaxVariable": { "dark": "antaniText", "light": "lightText" },
    "syntaxString": { "dark": "greenSoft", "light": "greenLight" },
    "syntaxNumber": { "dark": "orangeSoft", "light": "#b5651f" },
    "syntaxType": { "dark": "teal", "light": "tealLight" },
    "syntaxOperator": { "dark": "#aab0b8", "light": "#6b6f78" },
    "syntaxPunctuation": { "dark": "antaniTextDim", "light": "lightTextDim" }
  }
}
